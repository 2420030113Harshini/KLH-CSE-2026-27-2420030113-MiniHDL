digraph Redundant {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  { rank=source;
    n2 [label="a", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n3 [label="b", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n4 [label="c", shape=invhouse, style=filled, fillcolor="#cde7c8"];
  }
  g0 [label="AND", shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  n2 -> g0 [label="a"];
  n3 -> g0 [label="b"];
  g0 -> n5;
  g1 [label="XOR", shape=box, style="rounded,filled", fillcolor="#d1c4e9"];
  n4 -> g1 [label="a"];
  n2 -> g1 [label="b"];
  g1 -> n25;
  { rank=sink;
    out_x_0 [label="x", shape=house, style=filled, fillcolor="#f8c9c9"];
    out_y_0 [label="y", shape=house, style=filled, fillcolor="#f8c9c9"];
    out_z_0 [label="z", shape=house, style=filled, fillcolor="#f8c9c9"];
    out_w_0 [label="w", shape=house, style=filled, fillcolor="#f8c9c9"];
  }
  n5 -> out_x_0;
  n2 -> out_y_0;
  n25 -> out_z_0;
  n2 -> out_w_0;
  n5 [label="", shape=point, width=0.06];
  n25 [label="", shape=point, width=0.06];
}
