digraph Mux4 {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  { rank=source;
    n2 [label="d[0]", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n3 [label="d[1]", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n4 [label="d[2]", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n5 [label="d[3]", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n6 [label="s[0]", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n7 [label="s[1]", shape=invhouse, style=filled, fillcolor="#cde7c8"];
  }
  g0 [label="MUX", shape=box, style="rounded,filled", fillcolor="#ffe0b2"];
  n6 -> g0 [label="sel"];
  n5 -> g0 [label="1"];
  n4 -> g0 [label="0"];
  g0 -> n8;
  g1 [label="MUX", shape=box, style="rounded,filled", fillcolor="#ffe0b2"];
  n6 -> g1 [label="sel"];
  n3 -> g1 [label="1"];
  n2 -> g1 [label="0"];
  g1 -> n9;
  g2 [label="MUX", shape=box, style="rounded,filled", fillcolor="#ffe0b2"];
  n7 -> g2 [label="sel"];
  n8 -> g2 [label="1"];
  n9 -> g2 [label="0"];
  g2 -> n10;
  { rank=sink;
    out_y_0 [label="y", shape=house, style=filled, fillcolor="#f8c9c9"];
  }
  n10 -> out_y_0;
  n8 [label="", shape=point, width=0.06];
  n9 [label="", shape=point, width=0.06];
  n10 [label="", shape=point, width=0.06];
}
