digraph FullAdder {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  { rank=source;
    n2 [label="a", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n3 [label="b", shape=invhouse, style=filled, fillcolor="#cde7c8"];
    n4 [label="cin", shape=invhouse, style=filled, fillcolor="#cde7c8"];
  }
  g0 [label="XOR", shape=box, style="rounded,filled", fillcolor="#d1c4e9"];
  n2 -> g0 [label="a"];
  n3 -> g0 [label="b"];
  g0 -> n5;
  g1 [label="AND", shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  n2 -> g1 [label="a"];
  n3 -> g1 [label="b"];
  g1 -> n6;
  g2 [label="XOR", shape=box, style="rounded,filled", fillcolor="#d1c4e9"];
  n5 -> g2 [label="a"];
  n4 -> g2 [label="b"];
  g2 -> n7;
  g3 [label="AND", shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  n5 -> g3 [label="a"];
  n4 -> g3 [label="b"];
  g3 -> n8;
  g4 [label="OR", shape=box, style="rounded,filled", fillcolor="#bbdefb"];
  n6 -> g4 [label="a"];
  n8 -> g4 [label="b"];
  g4 -> n9;
  { rank=sink;
    out_sum_0 [label="sum", shape=house, style=filled, fillcolor="#f8c9c9"];
    out_cout_0 [label="cout", shape=house, style=filled, fillcolor="#f8c9c9"];
  }
  n7 -> out_sum_0;
  n9 -> out_cout_0;
  n5 [label="", shape=point, width=0.06];
  n6 [label="", shape=point, width=0.06];
  n7 [label="", shape=point, width=0.06];
  n8 [label="", shape=point, width=0.06];
  n9 [label="", shape=point, width=0.06];
}
